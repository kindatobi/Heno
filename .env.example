# Heno — environment variables

# === REQUIRED ==============================================================

# Postgres connection string.
# Also used by `prisma generate` (runs on npm install), `prisma migrate`,
# and `tsx db/seed.ts`.
# Hosted: copy from Neon / Supabase / Railway dashboard
DATABASE_URL=

# Secret used to sign sessions and cookies (better-auth).
# Generate one:  openssl rand -base64 32
# Without this, sessions are invalidated on every server restart.
BETTER_AUTH_SECRET=

# Base URL better-auth builds callback URLs from.
BETTER_AUTH_URL=http://localhost:3000

# Public base URL of the app. Used for Stripe success/cancel redirects and
# for order-confirmation email links, so checkout breaks if this is unset.
# NOTE: overlaps with NEXT_PUBLIC_SERVER_URL below — keep them the same.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# === PAYMENTS (Stripe) =====================================================
# https://dashboard.stripe.com/test/apikeys — use TEST mode keys.

# Secret key. Starts with sk_test_ in test mode.
STRIPE_SECRET_KEY=


# STRIPE WEBHOOK =====================================================
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx


# === CART STORAGE (Upstash Redis) ==========================================
# https://console.upstash.com 
REDIS_URL=https://your-db-name.upstash.io
REDIS_TOKEN=


# === EMAIL (Resend) ========================================================
# https://resend.com/api-keys 
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx


# === FILE UPLOADS (UploadThing) ============================================
# https://uploadthing.com/dashboard 
UPLOADTHING_TOKEN=


# === SOCIAL LOGIN (Google OAuth) ===========================================
# https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (type: Web application) and add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# === BACKGROUND JOBS (Inngest) =============================================
# https://app.inngest.com — Manage > Event Keys / Signing Key.
# Not needed against the local dev server (`npx inngest-cli@latest dev`);
# required for Inngest Cloud.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# === OPTIONAL — all of these have code defaults =============================
# Listed so you know they exist. 

# Default: "Heno"
# NEXT_PUBLIC_APP_NAME=Heno

# Default: "A modern e-commerce store built with Nextjs"
# NEXT_PUBLIC_APP_DESC=

# Default: http://localhost:3000  (see NEXT_PUBLIC_APP_URL above)
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Comma-space separated. Default: "Stripe, Paystack"
# PAYMENT_METHODS=Stripe, Paystack

# Comma-space separated. Default: "admin, user"
# USER_ROLES=admin, user

# Default: Onboarding@resend.dev
# Use the resend.dev sender until you've verified your own domain.
# SENDER_EMAIL=Onboarding@resend.dev
